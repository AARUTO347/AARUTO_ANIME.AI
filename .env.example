# AARUTO_ANIME.AI — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Server-side only — NEVER put secrets in frontend env vars.

# Groq API key (free text+TTS) — required for design / evolve / oracle / sensei / audio.
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# Required for Orpheus TTS (one-time acceptance):
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Pollinations API key (optional) — free flux image generation.
# https://enter.pollinations.ai
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Admin provisioning (optional)
# ADMIN_EMAIL=you@example.com
# Set ADMIN_PASSWORD_SCRYPT to the scrypt hash of the admin password, e.g.
# from a one-time Node script:
#   node -e "console.log(require('crypto').scryptSync('your-password', require('crypto').randomBytes(16).toString('hex'), 64).toString('hex'))"
# ADMIN_PASSWORD_SCRYPT=scrypt:<hex_salt>:<hex_hash>

# Session security
SESSION_TTL_MS=28800000
