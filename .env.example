# AARUTO_ANIME.AI — Environment Configuration
# Copy this file to `.env.local` and fill in your values.
# .env.local is git-ignored; never commit a real key.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
# NOTE: This is a purely client-side app — the key is embedded in the
# shipped bundle. See README.md "Security notes" before deploying publicly.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional (recommended): Groq free API key (https://console.groq.com/keys)
# When set, TEXT generation (design / evolve / oracle / sensei / re-rolls)
# automatically falls back to Groq's free Qwen/GPT models whenever Gemini fails
# (quota / invalid key / network). Also used directly when no Gemini key is set.
# Groq has NO image models — images stay Gemini-only (or Spectral Sketch).
# VITE_GROQ_API_KEY=gsk_your_groq_key_here
# Override the text model (defaults to qwen/qwen3.8-27b, verified with json_object mode):
# VITE_GROQ_TEXT_MODEL=qwen/qwen3.8-27b

# Pollinations key (https://enter.pollinations.ai) — free hosted flux image generation.
# Used automatically when Gemini image generation fails (e.g. free-tier 429, no billing).
# Works anonymously too, but a key raises rate limits and quality.
# VITE_POLLINATIONS_API_KEY=sk_your_pollinations_key_here

# Optional: demo admin account (build-time, shipped in the bundle — demo only).
# If unset, no admin account exists and only locally-registered users can log in.
# VITE_ADMIN_EMAIL=you@example.com
# VITE_ADMIN_PASSWORD=choose-a-strong-password

# Optional: Node version for local tooling
NODE_VERSION=20.11.1
NPM_VERSION=10.0.0
