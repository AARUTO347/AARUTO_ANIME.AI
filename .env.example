# AARUTO_ANIME.AI — Environment Configuration
# Copy this file to `.env.local` and fill in your values.
# .env.local is git-ignored; never commit a real key.
# The app runs a 100% FREE stack — no credit card required.

# Recommended: Groq free API key (https://console.groq.com/keys)
# Powers ALL text generation (design / evolve / oracle / sensei / re-rolls)
# and the free Orpheus TTS theme music. Note: Orpheus requires a one-time
# terms acceptance at:
#   https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
VITE_GROQ_API_KEY=your_groq_key_here

# Optional: override the Groq text model (default qwen/qwen3.8-27b, verified with json_object mode)
# VITE_GROQ_TEXT_MODEL=qwen/qwen3.8-27b

# Optional: Pollinations free key (https://enter.pollinations.ai)
# Free hosted flux image generation. The app also retries anonymously without a key.
# VITE_POLLINATIONS_API_KEY=your_pollinations_key_here

# Optional: demo admin account (build-time, shipped in the bundle — demo only).
# If unset, no admin account exists and only locally-registered users can log in.
# VITE_ADMIN_EMAIL=you@example.com
# VITE_ADMIN_PASSWORD=choose-a-strong-password

# Optional: Node version for local tooling
NODE_VERSION=20.11.1
NPM_VERSION=10.0.0
